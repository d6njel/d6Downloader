<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:D6Downloader"
             x:Class="D6Downloader.Sheets.DebridSheet"
             Width="560">
    <Grid RowDefinitions="Auto,*,Auto,Auto">
        <TextBlock Classes="title" Text="{l:Str Debrid.Title}"/>
        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="0,0,14,0">
                <TextBlock Classes="secondary" Text="{l:Str Debrid.Intro}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <CheckBox x:Name="EnabledBox" Content="{l:Str Debrid.Enable}" Click="Enabled_Click" Margin="0,10,0,6"/>
                <Grid ColumnDefinitions="90,*,Auto">
                    <TextBlock Text="{l:Str Debrid.Key}" VerticalAlignment="Center"/>
                    <TextBox x:Name="KeyBox" Grid.Column="1" PasswordChar="●" TextChanged="KeyBox_Changed"/>
                    <Button x:Name="CheckButton" Grid.Column="2" Content="{l:Str Debrid.Check}" Margin="8,0,0,0" Click="Check_Click"/>
                </Grid>
                <TextBlock x:Name="KeyState" Classes="secondary" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <Button x:Name="RemoveKeyButton" Classes="link" Content="{l:Str Debrid.RemoveKey}" Click="RemoveKey_Click"/>
                <TextBlock x:Name="CheckResult" TextWrapping="Wrap" Margin="0,4,0,0" IsVisible="False"/>

                <TextBlock Classes="section" Text="{l:Str Debrid.HostsSection}"/>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox x:Name="HostFilter" PlaceholderText="{l:Str Debrid.HostsFilter}" TextChanged="HostFilter_TextChanged"/>
                    <Button x:Name="LoadHostsButton" Grid.Column="1" Margin="8,0,0,0" Click="LoadHosts_Click"/>
                </Grid>
                <TextBlock x:Name="HostsState" Classes="secondary" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <ListBox x:Name="HostList" Classes="rows" MaxHeight="180" Margin="0,4,0,0"/>
            </StackPanel>
        </ScrollViewer>
        <TextBlock x:Name="ErrorText" Grid.Row="2" Classes="secondary error" Margin="0,8,0,0" TextWrapping="Wrap" IsVisible="False"/>
        <StackPanel Grid.Row="3" Classes="buttons">
            <Button Content="{l:Str Common.Cancel}" IsCancel="True" Click="Cancel_Click"/>
            <Button Content="{l:Str Common.Apply}" Classes="accent" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
