<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:D6Downloader"
             x:Class="D6Downloader.Sheets.PasswordSheet"
             Width="380">
    <StackPanel>
        <TextBlock Text="{l:Str Password.Title}" Classes="title" TextWrapping="Wrap"/>
        <TextBlock x:Name="Subject" Classes="secondary" TextWrapping="Wrap" Margin="0,4,0,0"/>
        <TextBox x:Name="PasswordInput" PasswordChar="●" Margin="0,8,0,0" TextChanged="Password_Changed"/>
        <TextBlock Classes="secondary" Text="{l:Str Password.Hint}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        <CheckBox x:Name="RememberBox" Content="{l:Str Password.Remember}" IsChecked="True" Margin="0,8,0,0"/>
        <StackPanel Classes="buttons">
            <Button Content="{l:Str Common.Cancel}" IsCancel="True" Click="Cancel_Click"/>
            <Button x:Name="Ok" Content="{l:Str Password.Go}" Classes="accent" IsDefault="True" IsEnabled="False" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</UserControl>
