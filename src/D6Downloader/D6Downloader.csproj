<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>D6Downloader</RootNamespace>
    <AssemblyName>d6downloader</AssemblyName>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Product>d6Downloader</Product>
    <Description>d6Downloader</Description>
    <!-- Die Git-Commit-Kennung nicht an die Version haengen (sonst "1.0.0+hash"). -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AvaloniaVersion>12.2.0</AvaloniaVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <!-- Benachrichtigungen über D-Bus. Dieselbe Version wie Avalonia.FreeDesktop. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\D6Downloader.Core\D6Downloader.Core.csproj" />
    <ProjectReference Include="..\D6Downloader.Platform.Linux\D6Downloader.Platform.Linux.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>linux</_Parameter1>
    </AssemblyAttribute>
    <InternalsVisibleTo Include="D6Downloader.Tests" />
    <InternalsVisibleTo Include="D6Downloader.UiTests" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\icon.png" />
    <!-- Freie Icon-Schrift (MIT), Lizenzdatei daneben. -->
    <AvaloniaResource Include="Assets\Fonts\*.ttf" />
    <None Include="Assets\Fonts\LICENSE-FluentSystemIcons.txt" Link="Licenses\LICENSE-FluentSystemIcons.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- Herkunftshinweis, unten in den Einstellungen angezeigt. -->
    <EmbeddedResource Include="..\..\NOTICE.md" LogicalName="NOTICE.md" />
  </ItemGroup>

  <!-- Browser-Erweiterung: Der Ordner "extension" im Repo landet als "Extension" neben dem Programm (Chrome, manifest.json mit
       service_worker), auch beim Veröffentlichen. Firefox braucht ein anderes Manifest (background.scripts): Es liegt als
       manifest.firefox.json im Repo und wird zu "Extension/firefox/manifest.json", daneben dieselben Dateien. -->
  <ItemGroup>
    <None Include="..\..\extension\**" Exclude="..\..\extension\manifest.firefox.json" Link="Extension\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\extension\**" Exclude="..\..\extension\manifest.json;..\..\extension\manifest.firefox.json" Link="Extension\firefox\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\extension\manifest.firefox.json" Link="Extension\firefox\manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
