<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="D6Downloader.App"
             Name="d6Downloader">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://d6downloader/Theme/Resources.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme DensityStyle="Compact">
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#0A6FDB"/>
                <ColorPaletteResources x:Key="Dark" Accent="#0A84FF"/>
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://d6downloader/Theme/Styles.axaml"/>
    </Application.Styles>
</Application>
